# m7d configuration (this file holds a secret: never commit it)
NODE_ENV=development
SERVER_HOST=0.0.0.0
SERVER_PORT=8787
M7D_TOKEN=change-me-at-least-16-chars

# Defaults only: both IPs can be changed in the dashboard (Settings → TV connection).
TV_HOST=
TV_SDB_PORT=26101
TV_REST_PORT=8001
TV_REMOTE_PORT=8002
SDB_IDLE_RELEASE_MS=5000
DATA_DIR=.data

# Dashboard on the TV itself
TRUST_TV_IP=true

# Apps2Samsung CLI (web UI for installs)
A2S_CLI_PATH=../tools/apps2samsung/apps2samsung-cli

# This box's IP on the TV's network (empty = detect; baked into the YouTube shim)
HOMELAB_IP=

# YouTube proxy for Cobalt on the TV (only the TV + these addresses are admitted)
YT_PROXY_PORT=8101
YT_PROXY_ALLOW=127.0.0.1
